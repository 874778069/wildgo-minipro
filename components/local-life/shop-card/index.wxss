.shop-card{margin-bottom:28rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.1);border-radius:30rpx;background:#131318;box-shadow:0 18rpx 44rpx rgba(0,0,0,.24)}.shop-card:active{transform:scale(.99);opacity:.92}.cover-wrap{position:relative;height:360rpx;overflow:hidden;background:linear-gradient(135deg,#37202e,#16131b)}.cover{display:block;width:100%;height:100%}.cover-empty{display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.3);font-size:22rpx;font-weight:800;letter-spacing:4rpx}.cover-mask{position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(10,10,13,.88))}.status{position:absolute;right:20rpx;top:20rpx;padding:9rpx 16rpx;border:1rpx solid rgba(255,255,255,.22);border-radius:999rpx;color:#0b0b0d;font-size:20rpx;font-weight:900;background:#b6ff00;backdrop-filter:blur(10rpx)}.status.SUSPENDED{color:#fff;background:rgba(108,108,116,.88)}.suspended .cover{filter:saturate(.55)}.content{padding:26rpx}.name{display:block;font-size:34rpx;font-weight:900;line-height:1.35}.address{display:flex;gap:8rpx;align-items:flex-start;margin-top:14rpx;color:#aaaab2;font-size:22rpx;line-height:1.5}.pin{color:#b6ff00}.description{display:-webkit-box;overflow:hidden;margin-top:16rpx;color:#85858e;font-size:23rpx;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:2}.more{margin-top:22rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.07);color:#d8d8dc;font-size:21rpx}.more text{margin-left:8rpx;color:#b6ff00;font-size:26rpx}
