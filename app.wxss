page{background:radial-gradient(circle at 90% 0%,rgba(139,69,255,.18),transparent 26%),radial-gradient(circle at 0% 24%,rgba(182,255,0,.08),transparent 24%),#0a0a0d;color:#f6f6f8;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}view,text,image,button,input,textarea,picker{box-sizing:border-box}button::after{border:none}.container{padding:24rpx}.section-title{display:flex;justify-content:space-between;align-items:center;margin:36rpx 0 20rpx}.section-title .main{font-size:34rpx;font-weight:800}.section-title .sub{color:#8f8f98;font-size:24rpx}.neon-button{background:linear-gradient(100deg,#b6ff00,#7fe600);color:#070707;font-size:30rpx;font-weight:900;border-radius:20rpx;box-shadow:0 0 30rpx rgba(182,255,0,.2)}.glass-card{border:1rpx solid rgba(255,255,255,.12);background:linear-gradient(145deg,rgba(255,255,255,.06),rgba(255,255,255,.025));border-radius:28rpx}