<view class="page"><view class="profile-hero"><view class="profile-glow"></view><view class="user-row"><view class="avatar">{{user.avatarText}}</view><view class="user-info"><text class="user-name">{{user.name}}</text><text class="user-level">{{user.level}}</text></view><text class="setting">⚙</text></view><view class="stats glass-card"><view wx:for="{{stats}}" wx:key="label" class="stat-item"><text class="stat-value">{{item.value}}</text><text class="stat-label">{{item.label}}</text></view></view></view><view class="container"><view class="section-title"><text class="main">我的订单</text><text class="sub">全部订单</text></view><view wx:for="{{orders}}" wx:key="id" class="order-card glass-card"><view class="order-top"><text class="order-title">{{item.title}}</text><text class="order-status">{{item.status}}</text></view><text class="order-date">{{item.date}}</text><view class="order-bottom"><text class="order-price">¥{{item.price}}</text><button size="mini" bindtap="goHome">查看行程</button></view></view><view class="section-title"><text class="main">常用服务</text></view><view class="menu-list glass-card"><view wx:for="{{menus}}" wx:key="*this" class="menu-item" bindtap="menuTap" data-name="{{item}}"><text>{{item}}</text><text class="arrow">›</text></view></view><view class="brand-block"><text class="brand-main">XTREME TRAVEL</text><text class="brand-sub">探索未知 · 潮流救赎</text></view></view></view>