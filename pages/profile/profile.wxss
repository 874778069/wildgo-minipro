 .profile-hero{min-height:500rpx;padding:54rpx 28rpx 28rpx;position:relative;overflow:hidden}.profile-glow{position:absolute;width:540rpx;height:540rpx;right:-220rpx;top:-200rpx;border-radius:50%;background:rgba(139,69,255,.28)}.user-row{position:relative;z-index:2;display:flex;align-items:center}.avatar{width:120rpx;height:120rpx;line-height:120rpx;text-align:center;border-radius:32rpx;background:linear-gradient(145deg,#b6ff00,#6dd300);color:#050505;font-size:44rpx;font-weight:900;box-shadow:0 0 34rpx rgba(182,255,0,.22)}.user-info{flex:1;margin-left:24rpx}.user-name,.user-level{display:block}.user-name{font-size:38rpx;font-weight:900}.user-level{margin-top:8rpx;color:#b6ff00;font-size:20rpx;letter-spacing:2rpx}.setting{font-size:38rpx}.stats{position:relative;z-index:2;margin-top:52rpx;padding:28rpx 10rpx;display:grid;grid-template-columns:repeat(3,1fr)}.stat-item{text-align:center;border-right:1rpx solid rgba(255,255,255,.08)}.stat-item:last-child{border-right:none}.stat-value,.stat-label{display:block}.stat-value{font-size:40rpx;font-weight:900}.stat-label{margin-top:8rpx;color:#92929a;font-size:22rpx}.order-card{padding:28rpx}.order-top,.order-bottom{display:flex;justify-content:space-between;align-items:center}.order-title{font-size:29rpx;font-weight:800}.order-status{color:#b6ff00;font-size:22rpx}.order-date{display:block;margin-top:14rpx;color:#92929a;font-size:23rpx}.order-bottom{margin-top:26rpx}.order-price{color:#ffd83d;font-size:34rpx;font-weight:900}.order-bottom button{margin:0;color:#b6ff00;border:1rpx solid rgba(182,255,0,.35);background:rgba(182,255,0,.06)}.menu-list{overflow:hidden}.menu-item{height:94rpx;padding:0 26rpx;display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid rgba(255,255,255,.08);font-size:26rpx}.menu-item:last-child{border-bottom:none}.arrow{color:#6f6f77;font-size:38rpx}.brand-block{padding:70rpx 0 40rpx;text-align:center}.brand-main,.brand-sub{display:block}.brand-main{color:#b6ff00;font-size:26rpx;font-weight:900;font-style:italic}.brand-sub{margin-top:10rpx;color:#5f5f66;font-size:20rpx}