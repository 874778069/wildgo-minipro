<view class="page">
  <swiper class="banner" indicator-dots autoplay circular interval="4000" wx:if="{{banner.length}}">
    <swiper-item wx:for="{{banner}}" wx:key="id" bindtap="goActivityDetail" data-id="{{item.id}}">
      <image src="{{item.image}}" mode="aspectFill" />
      <view class="banner-mask"></view>
      <view class="banner-title">{{item.title}}</view>
    </swiper-item>
  </swiper>
  <view class="banner placeholder" wx:else>
    <view>去更远的地方</view>
    <text>WILDGO · EXPLORE MORE</text>
  </view>

  <view class="container">
    <view class="section-title"><text class="main">探索方式</text><text class="sub">CHOOSE YOUR WAY</text></view>
    <view class="entrances">
      <view class="entrance free" bindtap="goActivityList">
        <text class="entrance-tag">NOW</text><text class="entrance-title">自由行</text><text class="entrance-sub">发现精选旅行活动 →</text>
      </view>
      <view class="entrance bbq" bindtap="goLocalLife">
        <text class="entrance-tag">LOCAL</text><text class="entrance-title">虾场烧烤店</text><text class="entrance-sub">钓虾 · 烧烤 · 团建 →</text>
      </view>
    </view>

    <view class="section-title"><text class="main">WildGo 推荐</text><text class="sub">活动 · 套餐</text></view>
    <view class="waterfall" wx:if="{{activityItems.length || shopProductItems.length}}">
      <view class="column">
        <view class="column-title">活动</view>
        <view class="activity-card" wx:for="{{activityItems}}" wx:key="targetUrl" bindtap="goRecommendDetail" data-url="{{item.targetUrl}}">
          <view class="cover-box">
            <image src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.imageHeight}}rpx;" />
            <text class="type-tag {{item.type}}">{{item.typeText}}</text>
          </view>
          <view class="activity-info"><text class="title">{{item.title}}</text><text class="location">⌖ {{item.subtitle || '信息待定'}}</text><view class="meta"><text class="price">¥{{item.priceText}}</text><text>{{(item.maxPeople || '不限') + '人'}}</text></view></view>
        </view>
      </view>
      <view class="column">
        <view class="column-title">套餐</view>
        <view class="activity-card" wx:for="{{shopProductItems}}" wx:key="targetUrl" bindtap="goRecommendDetail" data-url="{{item.targetUrl}}">
          <view class="cover-box">
            <image src="{{item.coverUrl}}" mode="aspectFill" style="height: {{item.imageHeight}}rpx;" />
            <text class="type-tag {{item.type}}">{{item.typeText}}</text>
          </view>
          <view class="activity-info"><text class="title">{{item.title}}</text><text class="location">⌖ {{item.subtitle || '信息待定'}}</text><view class="meta"><text class="price">¥{{item.priceText}}</text><text>到店体验</text></view></view>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>{{loading ? '正在加载...' : '暂无推荐内容'}}</view>
  </view>
  <view class="bottom-glow"></view>
</view>
