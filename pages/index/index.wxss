.page{min-height:100vh;padding-bottom:40rpx}.banner{position:relative;height:600rpx}.banner image{width:100%;height:100%}.banner-mask{position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,#0a0a0d 100%)}.banner-title{position:absolute;right:34rpx;bottom:50rpx;left:34rpx;color:#fff;font-size:48rpx;font-weight:900}.placeholder{display:flex;flex-direction:column;justify-content:flex-end;padding:50rpx 34rpx;background:linear-gradient(140deg,#24133e,#101018)}.placeholder view{font-size:58rpx;font-weight:900}.placeholder text{margin-top:14rpx;color:#b6ff00;font-size:20rpx;letter-spacing:3rpx}.container{padding:0 24rpx}.entrances{display:flex;gap:16rpx}.entrance{display:flex;flex:1;height:220rpx;padding:24rpx;flex-direction:column;justify-content:flex-end;border:1rpx solid rgba(255,255,255,.1);border-radius:26rpx}.entrance.free{background:linear-gradient(145deg,rgba(182,255,0,.22),#121512 65%)}.entrance.bbq{background:linear-gradient(145deg,rgba(129,65,255,.32),#121117 65%)}.entrance-tag{align-self:flex-start;margin-bottom:auto;padding:6rpx 10rpx;color:#b6ff00;font-size:18rpx;border:1rpx solid rgba(182,255,0,.4);border-radius:8rpx}.entrance-title{font-size:31rpx;font-weight:900}.entrance-sub{margin-top:10rpx;color:#9898a0;font-size:20rpx}.waterfall{display:flex;gap:16rpx;align-items:flex-start}.column{width:calc(50% - 8rpx)}.activity-card{margin-bottom:16rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.09);border-radius:24rpx;background:#111116}.activity-card image{display:block;width:100%;background:#1d1d24}.activity-info{padding:18rpx}.activity-info .title,.location{display:block}.activity-info .title{overflow:hidden;font-size:27rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.location{margin-top:10rpx;color:#8e8e97;font-size:20rpx}.meta{display:flex;align-items:flex-end;justify-content:space-between;margin-top:16rpx;color:#777780;font-size:18rpx}.meta .price{color:#b6ff00;font-size:30rpx;font-weight:900}.empty{padding:80rpx 0;color:#777;text-align:center}
