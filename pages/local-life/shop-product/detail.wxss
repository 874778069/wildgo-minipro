.page {
  min-height: 100vh;
  padding-bottom: 156rpx;
  background:
    radial-gradient(
      circle at 100% 42%,
      rgba(139, 69, 255, 0.12),
      transparent 25%
    ),
    #0a0a0d;
}
.loading-state,
.error-state {
  display: flex;
  width: 100%;
  height: 80vh;
  padding: 40rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #777780;
  font-size: 23rpx;
  text-align: center;
}
.loading-state > text,
.error-state > text {
  display: block;
  width: 100%;
  text-align: center;
}
.loading-ring {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #28282e;
  border-top-color: #b6ff00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.error-icon {
  color: #b6ff00;
  font-size: 72rpx;
}
.error-title {
  margin-top: 18rpx;
  color: #eee;
  font-size: 29rpx;
  font-weight: 900;
}
.error-state button {
  display: flex;
  width: 220rpx;
  height: 76rpx;
  margin-top: 30rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #080809;
  font-weight: 800;
  line-height: normal;
  text-align: center;
  background: #b6ff00;
}
.cover-wrap {
  position: relative;
  height: 650rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #34213b, #151319);
}
.cover-wrap image,
.cover-empty {
  width: 100%;
  height: 100%;
}
.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.24);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}
.cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.03) 40%, #0a0a0d 100%);
}
.category {
  position: absolute;
  left: 28rpx;
  bottom: 38rpx;
  padding: 9rpx 15rpx;
  border: 1rpx solid rgba(182, 255, 0, 0.4);
  border-radius: 10rpx;
  color: #dcff7d;
  font-size: 20rpx;
  background: rgba(10, 10, 13, 0.6);
}
.content {
  padding-top: 0;
  margin-top: 18rpx;
  margin-bottom: 56rpx;
}
.product-head {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}
.name {
  display: block;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.35;
}
.price-line {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}
.currency {
  color: #b6ff00;
  font-size: 28rpx;
  font-weight: 900;
}
.price {
  color: #b6ff00;
  font-size: 58rpx;
  font-weight: 900;
}
.original {
  margin-left: 18rpx;
  color: #707078;
  font-size: 21rpx;
  text-decoration: line-through;
}
.section {
  margin-top: 40rpx;
}
.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 900;
}
.section-en {
  color: #5f5f67;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}
.description {
  display: block;
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 24rpx;
  color: #c7c7cc;
  font-size: 25rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  background: #131318;
}
.shop-card {
  padding: 16rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(182, 255, 0, 0.14);
  border-radius: 24rpx;
  background: linear-gradient(145deg, rgba(182, 255, 0, 0.08), #121217 55%);
}
.shop-card:active {
  transform: scale(0.99);
  opacity: 0.92;
}
.shop-main {
  display: flex;
  gap: 18rpx;
  align-items: stretch;
}
.shop-cover {
  flex: none;
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: #24242b;
}
.shop-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #080809;
  font-size: 44rpx;
  font-weight: 900;
  background: #b6ff00;
}
.shop-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}
.shop-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0;
  gap: 20rpx;
}
.shop-title-row > view:first-child {
  min-width: 0;
  flex: 1;
}
.shop-name {
  display: block;
  font-size: 29rpx;
  font-weight: 900;
}
.shop-address {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: #85858e;
  font-size: 21rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shop-actions {
  display: flex;
  flex: none;
  gap: 12rpx;
  align-items: center;
}
.shop-status {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  color: #dfff87;
  font-size: 18rpx;
  background: rgba(182, 255, 0, 0.1);
}
.phone-icon {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(182, 255, 0, 0.28);
  border-radius: 18rpx;
  color: #b6ff00;
  font-size: 30rpx;
  background: rgba(182, 255, 0, 0.1);
}
.phone-icon.disabled {
  opacity: 0.45;
}
.shop-row {
  display: flex;
  gap: 24rpx;
  padding: 14rpx 0 0;
}
.label {
  flex: none;
  width: 68rpx;
  color: #74747d;
  font-size: 21rpx;
}
.value {
  flex: 1;
  color: #c7c7cc;
  font-size: 23rpx;
  line-height: 1.5;
}
.empty-shops {
  padding: 42rpx 24rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  color: #777780;
  font-size: 23rpx;
  text-align: center;
}
.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  gap: 24rpx;
  align-items: center;
  border-top: 1rpx solid rgba(255, 255, 255, 0.09);
  background: rgba(10, 10, 13, 0.96);
  backdrop-filter: blur(20rpx);
}
.price-summary {
  flex: none;
}
.price-summary > text {
  display: block;
  color: #777780;
  font-size: 18rpx;
}
.price-summary view {
  margin-top: 4rpx;
  color: #b6ff00;
  font-size: 34rpx;
  font-weight: 900;
}
.price-summary view text {
  font-size: 21rpx;
}
.bottom-bar button {
  display: flex;
  height: 86rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  flex: 1;
  color: #080809;
  font-size: 29rpx;
  font-weight: 900;
  line-height: normal;
  text-align: center;
  border-radius: 22rpx;
  background: linear-gradient(100deg, #b6ff00, #8bea00);
  box-shadow: 0 0 30rpx rgba(182, 255, 0, 0.16);
}
