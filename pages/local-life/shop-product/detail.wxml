<view class="page">
  <view
    class="loading-state"
    wx:if="{{loading && !detail}}"
  >
    <view class="loading-ring"></view>
    <text>正在加载套餐...</text>
  </view>

  <view
    class="error-state"
    wx:elif="{{error && !detail}}"
  >
    <text class="error-icon">↻</text>
    <text class="error-title">套餐信息加载失败</text>
    <button bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{detail}}">
    <view class="cover-wrap">
      <image
        wx:if="{{detail.coverUrl}}"
        src="{{detail.coverUrl}}"
        mode="aspectFill"
      />
      <view
        wx:else
        class="cover-empty"
      >WILDGO LOCAL EXPERIENCE</view>
      <view class="cover-mask"></view>

    </view>

    <view class="container content">
      <view class="product-head">
        <text class="name">{{detail.name}}</text>
        <view class="price-line">
          <text class="currency">¥</text>
          <text class="price">{{detail.priceText}}</text>
          <text
            wx:if="{{detail.hasOriginalPrice}}"
            class="original"
          >原价 ¥{{detail.originalPriceText}}</text>
        </view>
      </view>

      <view
        wx:if="{{detail.hasGroupDetail}}"
        class="section"
      >
        <view class="section-heading">
          <text class="section-title">套餐详情</text>
          <text class="section-en">GROUP BUY</text>
        </view>
        <view class="group-card">
          <view
            wx:for="{{detail.groupDetail}}"
            wx:key="name"
            class="group-row"
          >
            <text class="group-dot">●</text>
            <text class="group-name">{{item.name}}</text>
            <view><text class="group-quantity">({{item.quantity}}) </text>
              <text class="group-price">¥{{item.priceText}}</text>
            </view>
          </view>
          <view class="group-summary">
            <view>
              <text>总价</text>
              <text>¥{{detail.groupTotalText}}</text>
            </view>
            <view class="deal-price">
              <text>团购价</text>
              <text>¥{{detail.priceText}}</text>
            </view>
          </view>
          <view class="group-remark">
            <text>{{detail.description || '套餐详情正在完善中，可联系门店了解更多。'}}</text>
          </view>
        </view>
      </view>

      <view class="section">
        <view class="section-heading">
          <text class="section-title">适用门店</text>
          <text class="section-en">{{shops.length}} LOCATIONS</text>
        </view>
        <view
          wx:for="{{shops}}"
          wx:key="id"
          class="shop-card"
          data-id="{{item.id}}"
          bindtap="goShop"
        >
          <view class="shop-main">
            <image
              wx:if="{{item.coverUrl}}"
              class="shop-cover"
              src="{{item.coverUrl}}"
              mode="aspectFill"
            />
            <view
              wx:else
              class="shop-cover shop-cover-empty"
            >W</view>
            <view class="shop-info">
              <view class="shop-title-row">
                <view>
                  <text class="shop-name">{{item.name || '门店信息'}}</text>
                  <text class="shop-address">{{item.address || '地址待完善'}}</text>
                </view>
              </view>
              <view class="shop-row">
                <text class="label">营业</text>
                <text class="value">{{item.businessHoursText}}</text>
              </view>
            </view>
          </view>
        </view>
        <view
          wx:if="{{!shops.length}}"
          class="empty-shops"
        >暂无适用门店</view>
      </view>
    </view>

    <view class="bottom-bar">
      <view class="price-summary">
        <text>到店价</text>
        <view><text>¥</text>{{detail.priceText}}</view>
      </view>
      <button
        loading="{{buying}}"
        disabled="{{buying}}"
        bindtap="buy"
      >{{buying ? '支付处理中' : '立即购买'}}</button>
    </view>
  </block>
</view>
