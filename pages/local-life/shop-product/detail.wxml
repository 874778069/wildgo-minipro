<view class="page">
  <view class="loading-state" wx:if="{{loading && !detail}}">
    <view class="loading-ring"></view>
    <text>正在加载套餐...</text>
  </view>

  <view class="error-state" wx:elif="{{error && !detail}}">
    <text class="error-icon">↻</text>
    <text class="error-title">套餐信息加载失败</text>
    <button bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{detail}}">
    <view class="cover-wrap">
      <image wx:if="{{detail.coverUrl}}" src="{{detail.coverUrl}}" mode="aspectFill" />
      <view wx:else class="cover-empty">WILDGO LOCAL EXPERIENCE</view>
      <view class="cover-mask"></view>
      <text class="category">{{detail.categoryName}}</text>
    </view>

    <view class="container content">
      <view class="product-head">
        <text class="name">{{detail.name}}</text>
        <view class="price-line">
          <text class="currency">¥</text>
          <text class="price">{{detail.priceText}}</text>
          <text wx:if="{{detail.hasOriginalPrice}}" class="original">原价 ¥{{detail.originalPriceText}}</text>
        </view>
      </view>

      <view class="section">
        <view class="section-heading">
          <text class="section-title">套餐介绍</text>
          <text class="section-en">EXPERIENCE</text>
        </view>
        <text class="description">{{detail.description || '套餐详情正在完善中，可联系门店了解更多。'}}</text>
      </view>

      <view class="section">
        <view class="section-heading">
          <text class="section-title">适用门店</text>
          <text class="section-en">LOCATION</text>
        </view>
        <view class="shop-card">
          <view class="shop-title-row">
            <text class="shop-name">{{detail.shop.name}}</text>
            <text wx:if="{{detail.shop.businessStatusText}}" class="shop-status">{{detail.shop.businessStatusText}}</text>
          </view>
          <view class="shop-row">
            <text class="label">地址</text>
            <text class="value">{{detail.shop.address || '地址待完善'}}</text>
          </view>
          <view class="shop-row">
            <text class="label">电话</text>
            <text class="value phone" bindtap="callShop">{{detail.shop.phone || '暂未提供'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-bar">
      <view class="price-summary">
        <text>到店价</text>
        <view><text>¥</text>{{detail.priceText}}</view>
      </view>
      <button loading="{{buying}}" disabled="{{buying}}" bindtap="buy">{{buying ? '正在创建订单' : '立即购买'}}</button>
    </view>
  </block>
</view>
