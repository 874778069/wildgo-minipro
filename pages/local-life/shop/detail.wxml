<view class="page">
  <view
    class="loading-state"
    wx:if="{{loading && !shop}}"
  >
    <view class="loading-ring"></view>
    <text>正在加载门店...</text>
  </view>

  <view
    class="error-state"
    wx:elif="{{error && !shop}}"
  >
    <text class="error-icon">↻</text>
    <text class="error-title">门店信息加载失败</text>
    <button bindtap="retry">重新加载</button>
  </view>

  <block wx:elif="{{shop}}">
    <view class="hero">
      <swiper
        wx:if="{{hasShopImages}}"
        class="hero-swiper"
        autoplay="{{hasMultipleShopImages}}"
        interval="3500"
        duration="450"
        indicator-dots="{{hasMultipleShopImages}}"
        indicator-color="rgba(255,255,255,.35)"
        indicator-active-color="#b6ff00"
        circular="{{hasMultipleShopImages}}"
      >
        <swiper-item
          wx:for="{{shopImages}}"
          wx:key="*this"
          data-url="{{item}}"
          bindtap="previewImage"
        >
          <image
            src="{{item}}"
            mode="aspectFill"
          />
        </swiper-item>
      </swiper>
      <view
        wx:else
        class="hero-empty"
      >WILDGO LOCAL</view>
      <view class="hero-mask"></view>
      <view class="hero-content">
        <view class="status {{shop.businessStatus}}">{{shop.businessStatusText}}</view>
        <view
          wx:if="{{hasShopImages}}"
          class="preview-tip"
        >点击图片查看大图</view>
        <text class="shop-name">{{shop.name}}</text>
        <text class="shop-address">⌖ {{shop.address}}</text>
      </view>
    </view>

    <view class="container content">
      <view class="quick-actions">
        <view class="action-card address-card">
          <text class="action-icon">⌖</text>
          <view>
            <text class="action-label">门店地址</text>
            <text class="action-value">{{shop.address}}</text>
          </view>
        </view>
        <view
          class="phone-icon {{shop.phone ? '' : 'disabled'}}"
          bindtap="callShop"
        >
          <text>☎</text>
        </view>
      </view>

      <view class="info-card">
        <view class="info-row hours">
          <text class="info-label">营业时间</text>
          <view class="info-value">
            <block wx:if="{{weeklyHours.length}}">
              <view
                wx:for="{{weeklyHours}}"
                wx:key="key"
                class="hour-row"
              >
                <text>{{item.label}}</text>
                <text>{{item.text}}</text>
              </view>
            </block>
            <text wx:else>{{shop.businessHoursText}}</text>
          </view>
        </view>
        <view class="info-row description">
          <text class="info-label">门店介绍</text>
          <text class="info-value">{{shop.description || '门店介绍正在完善中。'}}</text>
        </view>
      </view>

      <view class="section-heading">
        <view>
          <text class="section-title">到店套餐</text>
          <text class="section-sub">挑一个喜欢的体验</text>
        </view>
        <text class="count">{{products.length}} 个</text>
      </view>

      <view wx:if="{{products.length}}">
        <product-card
          wx:for="{{products}}"
          wx:key="id"
          product="{{item}}"
          bindselect="goProduct"
        />
      </view>
      <view
        class="empty-products"
        wx:else
      >
        <text>套餐正在准备中</text>
        <text>可以先电话联系门店了解详情</text>
      </view>
    </view>
  </block>
</view>
