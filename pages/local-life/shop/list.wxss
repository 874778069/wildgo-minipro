.page{min-height:100vh;padding-bottom:48rpx;background:radial-gradient(circle at 90% 0%,rgba(255,111,58,.2),transparent 30%),radial-gradient(circle at 0% 20%,rgba(139,69,255,.15),transparent 26%),#0a0a0d}.hero{position:relative;overflow:hidden;padding:76rpx 30rpx 56rpx}.eyebrow,.title,.subtitle{position:relative;z-index:2;display:block}.eyebrow{color:#ff9b67;font-size:19rpx;font-weight:800;letter-spacing:4rpx}.title{margin-top:18rpx;font-size:52rpx;font-weight:900;letter-spacing:-1rpx}.subtitle{margin-top:14rpx;color:#a8a8b0;font-size:24rpx}.hero-glow{position:absolute;right:-90rpx;bottom:-130rpx;width:340rpx;height:340rpx;border:50rpx solid rgba(255,116,58,.11);border-radius:50%}.shop-list{padding-top:0}.skeleton{margin-bottom:28rpx;padding-bottom:24rpx;overflow:hidden;border-radius:30rpx;background:#141419}.skeleton-cover{height:330rpx;background:linear-gradient(100deg,#18181e 25%,#24242c 45%,#18181e 65%);background-size:400% 100%;animation:shine 1.4s infinite}.skeleton-line{width:70%;height:24rpx;margin:18rpx 24rpx 0;border-radius:12rpx;background:#24242b}.skeleton-line.wide{width:52%;height:32rpx;margin-top:24rpx}.skeleton-line.short{width:38%}@keyframes shine{0%{background-position:100% 0}100%{background-position:0 0}}.state-card{display:flex;min-height:500rpx;padding:70rpx 36rpx;align-items:center;flex-direction:column;justify-content:center;border:1rpx solid rgba(255,255,255,.08);border-radius:30rpx;background:#121217;text-align:center}.state-card>text{display:block;width:100%;text-align:center}.state-icon{color:#b6ff00;font-size:72rpx}.state-title{margin-top:24rpx;font-size:31rpx;font-weight:900}.state-desc{margin-top:12rpx;color:#777780;font-size:22rpx}.retry-button{display:flex;width:240rpx;height:76rpx;margin-top:34rpx;padding:0;align-items:center;justify-content:center;color:#09090b;font-size:24rpx;font-weight:900;line-height:normal;text-align:center;border-radius:18rpx;background:#b6ff00}.list-footer{padding:28rpx 0;color:#66666e;font-size:20rpx;text-align:center}.list-footer.error{color:#ff9b67}
