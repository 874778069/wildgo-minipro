.page {
  min-height: 100vh;
  padding-bottom: 50rpx;
  background: #0a0a0d;
}
.loading-state,
.error-state {
  display: flex;
  width: 100%;
  height: 80vh;
  padding: 40rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  color: #777780;
  font-size: 23rpx;
  text-align: center;
}
.loading-state > text,
.error-state > text {
  display: block;
  width: 100%;
  text-align: center;
}
.loading-ring {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #28282e;
  border-top-color: #b6ff00;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.error-icon {
  color: #b6ff00;
  font-size: 72rpx;
}
.error-title {
  margin-top: 18rpx;
  color: #eee;
  font-size: 29rpx;
  font-weight: 900;
}
.error-state button {
  display: flex;
  width: 220rpx;
  height: 76rpx;
  margin-top: 30rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  color: #080809;
  font-weight: 800;
  line-height: normal;
  text-align: center;
  background: #b6ff00;
}
.hero {
  position: relative;
  height: 600rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #34202c, #111116);
}
.hero-swiper,
.hero image,
.hero-empty {
  width: 100%;
  height: 100%;
}
.hero-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.25);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}
.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 25%, #0a0a0d 100%);
  pointer-events: none;
}
.hero-content {
  position: absolute;
  right: 30rpx;
  bottom: 42rpx;
  left: 30rpx;
  pointer-events: none;
}
.preview-tip {
  display: inline-block;
  margin-left: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 18rpx;
  background: rgba(0, 0, 0, 0.38);
}
.status {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #09090b;
  font-size: 19rpx;
  font-weight: 900;
  background: #b6ff00;
}
.status.SUSPENDED {
  color: #fff;
  background: #6d6d75;
}
.shop-name,
.shop-address {
  display: block;
}
.shop-name {
  margin-top: 18rpx;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.25;
}
.shop-address {
  margin-top: 14rpx;
  color: #c1c1c7;
  font-size: 23rpx;
  line-height: 1.5;
}
.content {
  padding-top: 4rpx;
}
.quick-actions {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
  margin-top: 18rpx;
}
.action-card {
  display: flex;
  min-width: 0;
  padding: 22rpx;
  gap: 14rpx;
  align-items: flex-start;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 22rpx;
  background: #141419;
}
.address-card {
  flex: 1;
}
.phone-icon {
  display: flex;
  width: 94rpx;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(182, 255, 0, 0.28);
  border-radius: 28rpx;
  color: #b6ff00;
  font-size: 40rpx;
  background: linear-gradient(145deg, rgba(182, 255, 0, 0.12), #141419);
}
.phone-icon.disabled {
  opacity: 0.45;
}
.action-icon {
  flex: none;
  color: #b6ff00;
  font-size: 32rpx;
}
.action-card view {
  min-width: 0;
}
.action-label,
.action-value {
  display: block;
}
.action-label {
  color: #777780;
  font-size: 18rpx;
}
.action-value {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #ddd;
  font-size: 21rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.info-card {
  margin-top: 18rpx;
  padding: 4rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 24rpx;
  background: #121217;
}
.info-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
}
.info-row:last-child {
  border-bottom: 0;
}
.info-label {
  flex: none;
  width: 120rpx;
  color: #777780;
  font-size: 21rpx;
}
.info-value {
  flex: 1;
  color: #d2d2d7;
  font-size: 23rpx;
  line-height: 1.65;
}
.hour-row {
  display: flex;
  padding: 5rpx 0;
  gap: 24rpx;
  align-items: center;
  justify-content: space-between;
}
.hour-row text:first-child {
  flex: none;
  color: #85858e;
}
.hour-row text:last-child {
  flex: 1;
  text-align: right;
}
.info-row.description .info-value {
  white-space: pre-wrap;
}
.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 42rpx 0 22rpx;
}
.section-heading text {
  display: block;
}
.section-title {
  font-size: 35rpx;
  font-weight: 900;
}
.section-sub {
  margin-top: 7rpx;
  color: #777780;
  font-size: 20rpx;
}
.count {
  color: #b6ff00;
  font-size: 20rpx;
}
.empty-products {
  display: flex;
  padding: 70rpx 20rpx;
  align-items: center;
  flex-direction: column;
  border: 1rpx dashed rgba(255, 255, 255, 0.11);
  border-radius: 24rpx;
  color: #aaa;
  font-size: 25rpx;
  text-align: center;
}
.empty-products text {
  display: block;
  width: 100%;
  text-align: center;
}
.empty-products text:last-child {
  margin-top: 12rpx;
  color: #666;
  font-size: 20rpx;
}
