.page{min-height:100vh;padding-bottom:150rpx;background:#0a0a0d}.state-page{display:flex;height:78vh;padding:40rpx;align-items:center;flex-direction:column;justify-content:center;color:#85858e;text-align:center}.state-page>text{display:block;width:100%;text-align:center}.loading-ring{width:54rpx;height:54rpx;margin-bottom:24rpx;border:5rpx solid #29292f;border-top-color:#b6ff00;border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.state-icon{color:#b6ff00;font-size:70rpx}.state-title{margin-top:14rpx;color:#fff;font-size:30rpx;font-weight:900}.state-page button{display:flex;width:220rpx;height:76rpx;margin-top:28rpx;align-items:center;justify-content:center;color:#09090b;font-weight:900;line-height:normal;background:#b6ff00}.hero{padding-top:52rpx;padding-bottom:44rpx;background:radial-gradient(circle at 92% 0,rgba(182,255,0,.17),transparent 38%)}.eyebrow{color:#73737c;font-size:17rpx;letter-spacing:3rpx}.status-row{display:flex;margin-top:20rpx;gap:18rpx;align-items:center;justify-content:space-between}.status{font-size:48rpx;font-weight:900}.status.WAIT_PAY{color:#ffbf47}.status.PAID{color:#b6ff00}.status.USED{color:#8d8d95}.status.CANCELLED,.status.REFUND{color:#777}.order-no{max-width:380rpx;color:#686871;font-size:18rpx;word-break:break-all}.status-tip{display:block;margin-top:14rpx;color:#a7a7ad;font-size:22rpx}.content{padding-top:0}.product-card{display:flex;padding:22rpx;border:1rpx solid rgba(255,255,255,.09);border-radius:26rpx;background:#131318}.product-card image,.cover-empty{width:150rpx;height:150rpx;flex:none;border-radius:20rpx}.cover-empty{display:flex;align-items:center;justify-content:center;color:#080809;font-size:46rpx;font-weight:900;background:#b6ff00}.product-info{display:flex;min-width:0;margin-left:22rpx;flex-direction:column;justify-content:center}.product-info text{display:block}.shop{color:#85858e;font-size:20rpx}.name{margin-top:9rpx;font-size:29rpx;font-weight:900;line-height:1.4}.quantity{margin-top:10rpx;color:#71717a;font-size:20rpx}.group-card{margin-top:24rpx;padding:22rpx 26rpx;border:1rpx solid rgba(255,255,255,.09);border-radius:24rpx;background:linear-gradient(145deg,rgba(182,255,0,.07),#131318 48%)}.group-title{display:block;margin-bottom:12rpx;font-size:30rpx;font-weight:900}.group-row{display:flex;min-height:62rpx;gap:12rpx;align-items:center}.group-dot{flex:none;color:#b6ff00;font-size:16rpx}.group-name{overflow:hidden;flex:1;color:#f0f0f2;font-size:24rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.group-quantity{flex:none;width:110rpx;overflow:hidden;color:#85858e;font-size:21rpx;text-align:center;text-overflow:ellipsis;white-space:nowrap}.group-price{flex:none;min-width:110rpx;color:#f4f4f5;font-size:24rpx;font-weight:900;text-align:right}.group-summary{margin-top:12rpx;padding-top:18rpx;border-top:1rpx solid rgba(255,255,255,.08)}.group-summary view{display:flex;align-items:baseline;justify-content:flex-end;gap:30rpx;color:#c6c6cc;font-size:24rpx;line-height:1.8}.group-summary view text:first-child{color:#85858e}.group-summary .deal-price text:last-child{color:#b6ff00;font-size:32rpx;font-weight:900}.verification-card{display:flex;margin-top:24rpx;padding:36rpx 24rpx;align-items:center;flex-direction:column;border:1rpx solid rgba(182,255,0,.22);border-radius:28rpx;background:linear-gradient(160deg,rgba(182,255,0,.09),#121217 48%)}.card-title{font-size:34rpx;font-weight:900;text-align:center}.card-tip{margin:10rpx 0 28rpx;color:#898992;font-size:20rpx;text-align:center}.code{margin-top:24rpx;color:#dfff8a;font-size:27rpx;font-weight:900;letter-spacing:3rpx}.copy-tip{margin-top:8rpx;color:#62626a;font-size:18rpx}.info-card{margin-top:24rpx;padding:12rpx 26rpx;border:1rpx solid rgba(255,255,255,.08);border-radius:24rpx;background:#121217}.info-card view{display:flex;padding:20rpx 0;align-items:center;justify-content:space-between;border-bottom:1rpx solid rgba(255,255,255,.06);color:#85858e;font-size:22rpx}.info-card view:last-child{border:0}.info-card view text:last-child{max-width:440rpx;color:#d2d2d7;text-align:right}.info-card .amount text:last-child{color:#b6ff00;font-size:30rpx;font-weight:900}.bottom-bar{position:fixed;right:0;bottom:0;left:0;z-index:20;display:flex;min-height:132rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));gap:24rpx;align-items:center;border-top:1rpx solid rgba(255,255,255,.09);background:rgba(10,10,13,.97)}.bottom-bar>view{display:flex;flex-direction:column;color:#777780;font-size:18rpx}.amount-price{margin-top:3rpx;color:#b6ff00;font-size:34rpx;font-weight:900}.bottom-bar button{display:flex;height:84rpx;align-items:center;justify-content:center;flex:1;color:#080809;font-size:27rpx;font-weight:900;line-height:normal;border-radius:21rpx;background:#b6ff00}.refund-bar .refund-button{color:#fff;background:#2a181b;border:1rpx solid rgba(255,90,95,.48)}
