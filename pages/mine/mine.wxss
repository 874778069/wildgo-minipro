.page{min-height:100vh}.profile{display:flex;align-items:center;padding:70rpx 10rpx 46rpx}.profile image,.avatar{width:116rpx;height:116rpx;margin-right:24rpx;border:2rpx solid #b6ff00;border-radius:50%}.avatar{color:#0a0a0d;font-size:44rpx;font-weight:900;line-height:116rpx;text-align:center;background:#b6ff00}.profile view>text{display:block;font-size:34rpx;font-weight:900}.profile .member{margin-top:10rpx;color:#8b8b93;font-size:19rpx;letter-spacing:2rpx}.registration-card{display:flex;align-items:flex-end;justify-content:space-between;padding:34rpx;border:1rpx solid rgba(182,255,0,.2);border-radius:30rpx;background:linear-gradient(135deg,rgba(182,255,0,.14),#111116 64%)}.registration-card text{display:block}.eyebrow{color:#b6ff00;font-size:18rpx;letter-spacing:2rpx}.registration-card .title{margin-top:20rpx;font-size:36rpx;font-weight:900}.desc{margin-top:12rpx;color:#85858d;font-size:21rpx}.count{color:#b6ff00;font-size:54rpx;font-weight:900}.count text{display:inline;color:#888;font-size:20rpx}.menus{margin-top:28rpx;padding:0 26rpx;border:1rpx solid rgba(255,255,255,.09);border-radius:26rpx;background:#111116}.menus view{display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid rgba(255,255,255,.07);font-size:25rpx}.menus view:last-child{border:0}.menus view text:last-child{color:#b6ff00}
