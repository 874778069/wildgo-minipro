.page {
  min-height: 100vh;
}

.profile {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  gap: 22rpx;
  padding: 70rpx 10rpx 46rpx;
}

.profile-avatar,
.avatar {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  border: 2rpx solid #b6ff00;
  border-radius: 50%;
}

.avatar {
  color: #0a0a0d;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 116rpx;
  text-align: center;
  background: #b6ff00;
}

.profile-info {
  flex: 1;
  width: 0;
  min-width: 0;
}

.nickname {
  display: block;
  overflow: hidden;
  color: #fff;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member {
  display: block;
  margin-top: 10rpx;
  width: 100%;
  color: #8b8b93;
  font-size: 19rpx;
  letter-spacing: 2rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.login-button {
  width: 132rpx;
  height: 58rpx;
  flex: 0 0 132rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #080809;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
  background: #b6ff00;
}

.login-button::after {
  border: 0;
}

.registration-card {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 34rpx;
  border: 1rpx solid rgba(182, 255, 0, 0.2);
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(182, 255, 0, 0.14), #111116 64%);
}

.registration-card text {
  display: block;
}

.eyebrow {
  color: #b6ff00;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.registration-card .title {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.desc {
  margin-top: 12rpx;
  color: #85858d;
  font-size: 21rpx;
}

.count {
  color: #b6ff00;
  font-size: 54rpx;
  font-weight: 900;
}

.count text {
  display: inline;
  color: #888;
  font-size: 20rpx;
}

.order-card {
  margin-top: 24rpx;
  border-color: rgba(139, 69, 255, 0.28);
  background: linear-gradient(135deg, rgba(139, 69, 255, 0.16), #111116 64%);
}

.menus {
  margin-top: 28rpx;
  padding: 0 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 26rpx;
  background: #111116;
}

.menus view {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  font-size: 25rpx;
}

.menus view:last-child {
  border: 0;
}

.menus view text:last-child {
  color: #b6ff00;
}
