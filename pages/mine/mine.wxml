<view class="page container">
  <view class="profile" bindtap="syncProfile">
    <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
    <view class="avatar" wx:else>W</view>
    <view><text>{{user.nickname}}</text><text class="member">WILDGO MEMBER · 点击同步微信资料</text></view>
  </view>
  <view class="registration-card" bindtap="goRegistrations">
    <view><text class="eyebrow">MY TRIPS</text><text class="title">我的报名</text><text class="desc">查看活动报名与确认状态</text></view>
    <view class="count">{{registrationCount}}<text> 条</text></view>
  </view>
  <view class="registration-card order-card" bindtap="goOrders">
    <view><text class="eyebrow">LOCAL ORDERS</text><text class="title">我的套餐</text><text class="desc">查看本地生活订单与核销码</text></view>
    <view class="count">{{orderCount}}<text> 单</text></view>
  </view>
  <view class="menus">
    <view bindtap="comingSoon"><text>联系客服</text><text>→</text></view>
    <view bindtap="comingSoon"><text>关于 WildGo</text><text>→</text></view>
  </view>
</view>
