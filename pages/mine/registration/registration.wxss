.page{min-height:100vh}.heading{padding:42rpx 0 30rpx}.heading>text{font-size:46rpx;font-weight:900}.heading view{margin-top:10rpx;color:#808088;font-size:22rpx}.card{margin-bottom:22rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.1);border-radius:26rpx;background:#111116}.activity{display:flex;padding:22rpx}.activity image{width:180rpx;height:150rpx;margin-right:20rpx;border-radius:18rpx;background:#222}.info{display:flex;min-width:0;flex:1;flex-direction:column;justify-content:center}.info text{display:block;margin-top:10rpx;color:#85858d;font-size:20rpx}.info .title{overflow:hidden;margin:0 0 4rpx;color:#fff;font-size:28rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.footer{display:flex;align-items:center;justify-content:space-between;padding:18rpx 22rpx;border-top:1rpx solid rgba(255,255,255,.07)}.status{color:#ffbd45;font-size:22rpx}.status.CONFIRMED{color:#b6ff00}.status.CANCELLED{color:#777}.footer button{margin:0;color:#bbb;border:1rpx solid #555;background:transparent}.empty{padding:160rpx 0;color:#777;text-align:center}.empty text{display:block;margin-top:16rpx;color:#555;font-size:21rpx}
