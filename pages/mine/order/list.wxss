.page{min-height:100vh;padding-bottom:60rpx}.heading{padding:48rpx 4rpx 30rpx}.heading text{display:block}.heading text:first-child{font-size:44rpx;font-weight:900}.heading text:last-child{margin-top:8rpx;color:#676770;font-size:18rpx;letter-spacing:3rpx}.order-card{margin-bottom:24rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.09);border-radius:28rpx;background:#121217}.top-line{display:flex;padding:22rpx 24rpx;align-items:center;justify-content:space-between;border-bottom:1rpx solid rgba(255,255,255,.06)}.shop{font-size:23rpx;font-weight:800}.status{font-size:21rpx;font-weight:800}.status.WAIT_PAY{color:#ffbf47}.status.PAID{color:#b6ff00}.status.USED{color:#85858e}.status.CANCELLED,.status.REFUND{color:#72727a}.product{display:flex;padding:24rpx}.product image,.cover-empty{width:154rpx;height:154rpx;flex:none;border-radius:20rpx}.cover-empty{display:flex;align-items:center;justify-content:center;color:#080809;font-size:44rpx;font-weight:900;background:#b6ff00}.info{display:flex;min-width:0;margin-left:22rpx;flex:1;flex-direction:column}.info text{display:block}.name{font-size:28rpx;font-weight:900;line-height:1.4}.time{margin-top:10rpx;color:#6f6f78;font-size:19rpx}.price{display:flex;margin-top:auto;align-items:baseline;justify-content:space-between}.price text:first-child{color:#777780;font-size:19rpx}.price text:last-child{color:#b6ff00;font-size:31rpx;font-weight:900}.footer{display:flex;padding:20rpx 24rpx;align-items:center;justify-content:flex-end;gap:12rpx;border-top:1rpx solid rgba(255,255,255,.06);color:#a5e900;font-size:21rpx}.state{display:flex;min-height:50vh;align-items:center;flex-direction:column;justify-content:center;color:#777780;font-size:24rpx;text-align:center}.state text{display:block;width:100%;text-align:center}.state .sub{margin-top:12rpx;color:#5e5e66;font-size:20rpx}.state button{display:flex;width:220rpx;height:76rpx;margin-top:26rpx;align-items:center;justify-content:center;color:#080809;font-weight:900;line-height:normal;background:#b6ff00}
