.page {
  min-height: 100vh;
  padding-top: 70rpx;
}

.login-head {
  padding: 20rpx 4rpx 46rpx;
}

.title,
.subtitle {
  display: block;
}

.title {
  color: #fff;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.2;
}

.subtitle {
  margin-top: 14rpx;
  color: #8d8d95;
  font-size: 24rpx;
  line-height: 1.5;
}

.login-card {
  display: flex;
  padding: 42rpx 30rpx 34rpx;
  align-items: center;
  flex-direction: column;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  background: linear-gradient(160deg, rgba(182, 255, 0, 0.1), #111116 48%);
}

.avatar-button {
  display: flex;
  width: 156rpx;
  height: 156rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
}

.avatar-button::after {
  border: 0;
}

.avatar-frame {
  position: relative;
  width: 148rpx;
  height: 148rpx;
  overflow: hidden;
  border: 2rpx solid #b6ff00;
  border-radius: 9999rpx;
  background: #b6ff00;
}

.avatar-image,
.avatar {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 9999rpx;
}

.avatar {
  color: #0a0a0d;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 148rpx;
  text-align: center;
  background: #b6ff00;
}

.avatar-tip {
  margin-top: 18rpx;
  color: #8b8b93;
  font-size: 22rpx;
}

.field {
  width: 100%;
  margin-top: 44rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.field text {
  display: block;
  color: #bdbdc3;
  font-size: 23rpx;
}

.field input {
  height: 66rpx;
  margin-top: 14rpx;
  color: #fff;
  font-size: 31rpx;
  font-weight: 800;
}

.submit-button {
  display: flex;
  width: 100%;
  height: 88rpx;
  margin-top: 38rpx;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #080809;
  font-size: 29rpx;
  font-weight: 900;
  line-height: normal;
  background: #b6ff00;
}

.submit-button::after {
  border: 0;
}
