 .page{padding-bottom:44rpx}.signup-head{padding:20rpx 0 26rpx}.signup-title,.signup-sub{display:block}.signup-title{font-size:44rpx;font-weight:900}.signup-sub{margin-top:12rpx;color:#93939c;font-size:24rpx;line-height:1.6}.form-card{padding:28rpx}.field{margin-bottom:30rpx}.field:last-child{margin-bottom:0}.label{display:block;margin-bottom:14rpx;font-size:25rpx;font-weight:800}input,textarea,.picker-value{width:100%;min-height:86rpx;padding:0 24rpx;border-radius:18rpx;border:1rpx solid rgba(255,255,255,.11);background:#0c0c10;color:#fff;font-size:25rpx}input{line-height:86rpx}textarea{min-height:160rpx;padding-top:24rpx}.picker-value{display:flex;justify-content:space-between;align-items:center}.counter-row{height:90rpx;display:flex;justify-content:space-between;align-items:center;border-bottom:1rpx solid rgba(255,255,255,.08);font-size:26rpx}.counter{display:flex;align-items:center;gap:24rpx}.counter button{width:56rpx;height:56rpx;line-height:52rpx;padding:0;border-radius:50%;border:1rpx solid rgba(255,255,255,.15);background:#23232a;color:#fff;font-size:32rpx}.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.option{padding:22rpx 14rpx;text-align:center;border-radius:18rpx;border:1rpx solid rgba(255,255,255,.12);background:#0d0d11;color:#b7b7bd;font-size:24rpx}.option.active{color:#b6ff00;border-color:#b6ff00;background:rgba(182,255,0,.08)}.summary{margin-top:22rpx;padding:26rpx 28rpx;display:flex;justify-content:space-between;align-items:center}.summary-price{color:#ffd83d;font-size:40rpx;font-weight:900}.submit-btn{margin-top:24rpx;height:94rpx;line-height:94rpx}