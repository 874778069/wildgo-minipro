.page{min-height:100vh}.heading{padding:48rpx 0 34rpx}.heading>text{display:block;font-size:45rpx;font-weight:900}.heading view{margin-top:14rpx;color:#92929b;font-size:24rpx}.form-card{padding:4rpx 26rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:28rpx;background:#111116}.form-card label{display:block;padding:26rpx 0;border-bottom:1rpx solid rgba(255,255,255,.07)}.form-card label:last-child{border:0}.form-card label>text{display:block;margin-bottom:16rpx;color:#bdbdc3;font-size:23rpx}.form-card input{height:60rpx;color:#fff;font-size:29rpx}.form-card textarea{width:100%;min-height:110rpx;color:#fff;font-size:27rpx;line-height:1.6}.notice{margin-top:24rpx;color:#777780;font-size:21rpx;line-height:1.65}.submit{margin-top:42rpx;height:88rpx;line-height:88rpx}
