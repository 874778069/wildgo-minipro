<view class="page container"><view class="signup-head"><text class="signup-title">提交报名信息</text><text class="signup-sub">先填写基础信息，客服确认名额后再补充游客证件资料。</text></view><form bindsubmit="submitForm"><view class="form-card glass-card"><view class="field"><text class="label">联系人姓名 *</text><input name="name" placeholder="请输入真实姓名"/></view><view class="field"><text class="label">手机号码 *</text><input name="phone" type="number" maxlength="11" placeholder="请输入手机号码"/></view><view class="field"><text class="label">微信号</text><input name="wechat" placeholder="选填，方便客服联系"/></view><view class="field"><text class="label">出发日期 *</text><picker mode="selector" range="{{dates}}" value="{{dateIndex}}" bindchange="onDateChange"><view class="picker-value">{{dates[dateIndex]}} <text>›</text></view></picker></view><view class="field"><text class="label">出行人数 *</text><view class="counter-row"><text>成人</text><view class="counter"><button type="button" data-type="adult" data-delta="-1" bindtap="changeCount">−</button><text>{{adult}}</text><button type="button" data-type="adult" data-delta="1" bindtap="changeCount">+</button></view></view><view class="counter-row"><text>儿童</text><view class="counter"><button type="button" data-type="child" data-delta="-1" bindtap="changeCount">−</button><text>{{child}}</text><button type="button" data-type="child" data-delta="1" bindtap="changeCount">+</button></view></view><view class="counter-row"><text>老人</text><view class="counter"><button type="button" data-type="senior" data-delta="-1" bindtap="changeCount">−</button><text>{{senior}}</text><button type="button" data-type="senior" data-delta="1" bindtap="changeCount">+</button></view></view></view><view class="field"><text class="label">上车城市 *</text><picker mode="selector" range="{{cityList}}" value="{{cityIndex}}" bindchange="onCityChange"><view class="picker-value">{{cityList[cityIndex]}} <text>›</text></view></picker></view><view class="field"><text class="label">护照情况</text><view class="option-grid"><view wx:for="{{passportOptions}}" wx:key="*this" class="option {{passportIndex===index?'active':''}}" bindtap="choosePassport" data-index="{{index}}">{{item}}</view></view></view><view class="field"><text class="label">房型偏好</text><view class="option-grid"><view wx:for="{{roomOptions}}" wx:key="*this" class="option {{roomIndex===index?'active':''}}" bindtap="chooseRoom" data-index="{{index}}">{{item}}</view></view></view><view class="field"><text class="label">特殊需求</text><textarea name="remark" placeholder="例如：老人同行、儿童不占床、素食、生日等"/></view></view><view class="summary glass-card"><text>预估基础总价</text><text class="summary-price">¥{{total}}</text></view><button class="submit-btn neon-button" form-type="submit">提交报名</button></form></view>