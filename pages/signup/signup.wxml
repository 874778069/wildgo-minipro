<view class="page container">
  <view class="heading"><text>填写报名信息</text><view>{{activity.title || 'WildGo 活动'}}</view></view>
  <form bindsubmit="submitForm">
    <view class="form-card">
      <label><text>姓名 *</text><input name="name" maxlength="100" placeholder="请输入报名人姓名" /></label>
      <label><text>手机号 *</text><input name="phone" type="number" maxlength="11" placeholder="用于接收活动通知" /></label>
      <label><text>微信号</text><input name="wechat" maxlength="100" placeholder="选填，方便工作人员联系" /></label>
      <label><text>备注</text><textarea name="remark" maxlength="500" auto-height placeholder="选填，可填写同行人数或其他需求" /></label>
    </view>
    <view class="notice">提交即表示您确认报名信息无误。工作人员确认后，报名状态会更新为“已确认”。</view>
    <button class="neon-button submit" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">提交报名</button>
  </form>
</view>
