.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.heading {
  padding: 42rpx 0 30rpx;
}

.heading > text {
  display: block;
  color: #fff;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.15;
}

.heading view {
  margin-top: 10rpx;
  color: #898991;
  font-size: 23rpx;
}

.waterfall {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.column {
  width: calc(50% - 9rpx);
}

.activity-card {
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 22rpx;
  background: #111116;
}

.activity-card image {
  display: block;
  width: 100%;
  background: #202027;
}

.content {
  padding: 18rpx 18rpx 20rpx;
}

.title,
.description,
.location {
  display: block;
}

.title {
  display: -webkit-box;
  overflow: hidden;
  color: #f5f5f7;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.description {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #92929b;
  font-size: 21rpx;
  line-height: 1.48;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.location {
  overflow: hidden;
  margin-top: 12rpx;
  color: #777780;
  font-size: 19rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  color: #777780;
  font-size: 18rpx;
}

.price {
  color: #b6ff00;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.price text {
  color: #777780;
  font-size: 17rpx;
  font-weight: 500;
}

.state {
  padding: 46rpx 0;
  color: #777780;
  font-size: 23rpx;
  text-align: center;
}
