.page{min-height:100vh}.heading{padding:36rpx 0}.heading>text{font-size:54rpx;font-weight:900}.heading view{margin-top:10rpx;color:#898991;font-size:23rpx}.activity-card{margin-bottom:24rpx;overflow:hidden;border:1rpx solid rgba(255,255,255,.1);border-radius:28rpx;background:#111116}.activity-card image{display:block;width:100%;height:360rpx;background:#202027}.content{position:relative;padding:24rpx}.title,.description{display:block}.title{font-size:32rpx;font-weight:900}.description{display:-webkit-box;overflow:hidden;margin-top:12rpx;color:#92929b;font-size:22rpx;line-height:1.55;-webkit-box-orient:vertical;-webkit-line-clamp:2}.info{display:flex;justify-content:space-between;margin-top:18rpx;padding-right:170rpx;color:#85858e;font-size:21rpx}.price{position:absolute;right:24rpx;bottom:20rpx;color:#b6ff00;font-size:34rpx;font-weight:900}.price text{color:#777;font-size:18rpx;font-weight:400}.state{padding:40rpx;color:#777;text-align:center}
