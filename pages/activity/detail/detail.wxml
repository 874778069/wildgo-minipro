<view
  class="page"
  wx:if="{{activity}}"
>
  <view class="cover">
    <image
      src="{{activity.coverUrl}}"
      mode="aspectFill"
    />
    <view class="mask"></view>
    <view class="cover-content"><text>{{activity.title}}</text>
      <view>⌖ {{activity.location || '地点待定'}}</view>
    </view>
  </view>
  <view class="container content">
    <view class="price-card glass-card">
      <view><text class="price">¥{{activity.price}}</text><text class="unit"> / 人</text></view>
      <text>{{activity.maxPeople ? '限 ' + activity.maxPeople + ' 人' : '人数不限'}}</text>
    </view>
    <view class="section-title"><text class="main">活动时间</text></view>
    <view class="detail-card">
      <view><text>开始</text><text>{{activity.startText}}</text></view>
      <view><text>结束</text><text>{{activity.endText}}</text></view>
    </view>
    <view class="section-title"><text class="main">活动介绍</text></view>
    <view class="description">{{activity.description || '更多活动介绍即将更新'}}</view>
    <view
      class="section-title"
      wx:if="{{activity.attachmentList.length}}"
    ><text class="main">活动附件</text><text class="sub">{{activity.attachmentList.length}} 个</text></view>
    <view
      class="attachments"
      wx:if="{{activity.attachmentList.length}}"
    >
      <view
        wx:for="{{activity.attachmentList}}"
        wx:key="url"
        class="attachment-card"
        bindtap="openAttachment"
        data-url="{{item.url}}"
        data-type="{{item.fileType}}"
      >
        <view class="file-icon">{{item.iconText}}</view>
        <view class="file-info">
          <text class="file-name">{{item.name}}</text>
          <text class="file-meta">{{item.sizeText}}</text>
        </view>
      </view>
    </view>
    <view
      class="section-title"
      wx:if="{{activity.imageList.length}}"
    ><text class="main">活动图片</text><text class="sub">{{activity.imageList.length}} 张</text></view>
    <view
      class="images"
      wx:if="{{activity.imageList.length}}"
    >
      <image
        wx:for="{{activity.imageList}}"
        wx:key="url"
        src="{{item.url}}"
        mode="widthFix"
        bindtap="previewImage"
        data-url="{{item.url}}"
      />
    </view>
  </view>
  <view class="bottom-bar"><button
      class="neon-button"
      bindtap="goSignup"
    >立即报名</button></view>
</view>
<view
  class="loading"
  wx:else
>{{loading ? '加载中...' : '活动不存在'}}</view>
