.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
}
.cover {
  position: relative;
  height: 650rpx;
}
.cover image {
  width: 100%;
  height: 100%;
}
.mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 30%, #0a0a0d 100%);
}
.cover-content {
  position: absolute;
  right: 30rpx;
  bottom: 42rpx;
  left: 30rpx;
}
.cover-content > text {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
}
.cover-content view {
  margin-top: 16rpx;
  color: #c5c5ca;
  font-size: 24rpx;
}
.content {
  padding-top: 10rpx;
}
.price-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  color: #8c8c95;
  font-size: 22rpx;
}
.price {
  color: #b6ff00;
  font-size: 44rpx;
  font-weight: 900;
}
.unit {
  color: #8b8b93;
  font-size: 20rpx;
}
.detail-card,
.description {
  padding: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 24rpx;
  background: #111116;
}
.detail-card view {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  color: #ddd;
  font-size: 23rpx;
}
.detail-card view text:first-child {
  color: #777;
}
.description {
  color: #c4c4ca;
  font-size: 25rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
.attachments {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.attachment-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 22rpx;
  background: #111116;
}
.file-icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(182, 255, 0, 0.12);
  color: #b6ff00;
  font-size: 20rpx;
  font-weight: 900;
}
.file-info {
  min-width: 0;
  flex: 1;
}
.file-name {
  display: block;
  overflow: hidden;
  color: #f5f5f7;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.file-meta {
  display: block;
  margin-top: 8rpx;
  color: #7e7e86;
  font-size: 21rpx;
}
.images {
  width: 100%;
  overflow: hidden;
  border-radius: 22rpx;
}
.images image {
  display: block;
  width: 100%;
  height: auto;
}
.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  background: rgba(10, 10, 13, 0.96);
}
.bottom-bar button {
  height: 86rpx;
  line-height: 86rpx;
}
.loading {
  padding-top: 300rpx;
  color: #777;
  text-align: center;
}
