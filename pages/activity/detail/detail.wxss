.page{min-height:100vh;padding-bottom:140rpx}.cover{position:relative;height:650rpx}.cover image{width:100%;height:100%}.mask{position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,#0a0a0d 100%)}.cover-content{position:absolute;right:30rpx;bottom:42rpx;left:30rpx}.cover-content>text{display:block;font-size:48rpx;font-weight:900}.cover-content view{margin-top:16rpx;color:#c5c5ca;font-size:24rpx}.content{padding-top:10rpx}.price-card{display:flex;align-items:center;justify-content:space-between;padding:28rpx;color:#8c8c95;font-size:22rpx}.price{color:#b6ff00;font-size:44rpx;font-weight:900}.unit{color:#8b8b93;font-size:20rpx}.detail-card,.description{padding:26rpx;border:1rpx solid rgba(255,255,255,.1);border-radius:24rpx;background:#111116}.detail-card view{display:flex;justify-content:space-between;padding:14rpx 0;color:#ddd;font-size:23rpx}.detail-card view text:first-child{color:#777}.description{color:#c4c4ca;font-size:25rpx;line-height:1.8;white-space:pre-wrap}.images{width:100%;white-space:nowrap}.images image{width:480rpx;height:320rpx;margin-right:16rpx;border-radius:22rpx}.bottom-bar{position:fixed;right:0;bottom:0;left:0;z-index:10;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid rgba(255,255,255,.1);background:rgba(10,10,13,.96)}.bottom-bar button{height:86rpx;line-height:86rpx}.loading{padding-top:300rpx;color:#777;text-align:center}
