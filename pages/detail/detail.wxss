 .page{padding-bottom:150rpx}.cover{height:760rpx;position:relative;overflow:hidden}.cover image{width:100%;height:100%}.cover-mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.04),rgba(0,0,0,.92))}.cover-content{position:absolute;left:32rpx;right:32rpx;bottom:42rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx}.tags text{padding:8rpx 12rpx;font-size:20rpx;border-radius:10rpx;color:#dfff87;border:1rpx solid rgba(182,255,0,.38);background:rgba(0,0,0,.45)}.cover-title{margin-top:20rpx;font-size:52rpx;font-weight:900}.cover-subtitle{margin-top:6rpx;color:#b6ff00;font-size:34rpx;font-weight:800}.cover-copy{margin-top:18rpx;color:#d5d5da;font-size:25rpx;line-height:1.65}.price-card{padding:28rpx;display:flex;justify-content:space-between;align-items:flex-end}.price{color:#ffd83d;font-size:62rpx;font-weight:900}.unit{color:#9898a1;font-size:22rpx}.date{color:#9db7ff;font-size:22rpx}.highlight-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx}.highlight-card{min-height:220rpx;padding:26rpx;border-radius:24rpx;border:1rpx solid rgba(255,255,255,.12);background:linear-gradient(145deg,rgba(139,69,255,.15),rgba(255,255,255,.02));position:relative;overflow:hidden}.highlight-card:nth-child(even){background:linear-gradient(145deg,rgba(182,255,0,.10),rgba(255,255,255,.02))}.highlight-title,.highlight-desc{display:block;position:relative;z-index:2}.highlight-title{font-size:28rpx;font-weight:800}.highlight-desc{margin-top:14rpx;color:#a0a0a8;font-size:22rpx;line-height:1.6}.highlight-num{position:absolute;right:10rpx;bottom:-10rpx;color:rgba(255,255,255,.055);font-size:76rpx;font-weight:900}.timeline{border-left:1rpx solid rgba(182,255,0,.34);margin-left:14rpx;padding-left:34rpx}.timeline-item{position:relative;margin-bottom:24rpx}.timeline-dot{width:18rpx;height:18rpx;position:absolute;left:-44rpx;top:34rpx;border-radius:50%;background:#b6ff00;box-shadow:0 0 20rpx rgba(182,255,0,.55)}.timeline-card{padding:26rpx;border-radius:22rpx;background:#15151b;border:1rpx solid rgba(255,255,255,.10)}.timeline-day,.timeline-title,.timeline-desc{display:block}.timeline-day{color:#b6ff00;font-size:22rpx;font-weight:800}.timeline-title{margin-top:8rpx;font-size:28rpx;font-weight:800}.timeline-desc{margin-top:10rpx;color:#b1b1b8;font-size:23rpx;line-height:1.65}.notice{overflow:hidden}.notice-row{padding:26rpx;display:flex;justify-content:space-between;gap:30rpx;border-bottom:1rpx solid rgba(255,255,255,.08);font-size:24rpx}.notice-row:last-child{border-bottom:none}.notice-row text:last-child{flex:1;text-align:right;color:#9b9ba3;line-height:1.55}.bottom-bar{position:fixed;left:0;right:0;bottom:0;height:132rpx;padding:16rpx 22rpx 22rpx;display:grid;grid-template-columns:100rpx 100rpx 1fr;gap:12rpx;background:rgba(10,10,13,.96);border-top:1rpx solid rgba(255,255,255,.10);z-index:20}.bottom-mini{text-align:center;color:#c6c6cb;font-size:20rpx;padding-top:8rpx}.bottom-mini text{display:block}.bottom-mini .icon{font-size:38rpx;margin-bottom:4rpx}.signup-btn{height:92rpx;line-height:92rpx;background:#b6ff00;color:#050505;border-radius:20rpx;font-size:30rpx;font-weight:900}